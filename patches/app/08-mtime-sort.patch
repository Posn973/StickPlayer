+    /** Last modification date in milliseconds since 1970, or null if unknown */
+    fun mtimeOf(mw: MediaWrapper): Long? {
+        if (mw.type == MediaWrapper.TYPE_DIR) return null
+        val uri = mw.uri ?: return null
+        val time = if (uri.scheme == "file") uri.path?.let { File(it).lastModified() } else remoteMtime[uri.toString()]
+        return time?.takeIf { it > 0L }
+    }
