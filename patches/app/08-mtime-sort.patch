+    /** Parse "vlcsize:<bytes>;mtime:<time>" written by the patched smb2/dsm modules */
+    internal fun storeRemoteInfo(uri: String, meta: String) {
+        for (part in meta.split(';')) {
+            val key = part.substringBefore(':')
+            val value = part.substringAfter(':', "").toLongOrNull() ?: continue
+            when (key) {
+                "vlcsize" -> remote[uri] = value
+                "mtime" -> toMillis(value)?.let { remoteMtime[uri] = it }
+            }
+        }
+    }
+
+    /** smb2 gives seconds, libdsm may give a Windows FILETIME (100 ns since 1601) */
+    private fun toMillis(value: Long): Long? = when {
+        value <= 0L -> null
+        value < 100_000_000_000L -> value * 1000L                          // seconds
+        value < 100_000_000_000_000L -> value                              // already milliseconds
+        else -> (value / 10_000L - 11_644_473_600_000L).takeIf { it > 0L } // FILETIME
+    }
 }
 
