+/** File sizes shared with the TV list (local: read from disk, SMB: sent by the patched libvlc) */
+object BrowserFileSizes {
+    internal val remote = java.util.concurrent.ConcurrentHashMap<String, Long>()
+
+    fun sizeOf(mw: MediaWrapper): Long? {
+        if (mw.type == MediaWrapper.TYPE_DIR) return null
+        val uri = mw.uri ?: return null
+        val size = if (uri.scheme == "file") uri.path?.let { File(it).length() } else remote[uri.toString()]
+        return size?.takeIf { it > 0L }
+    }
+}
