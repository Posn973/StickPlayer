+/** "1.24 GB · 1:23:45": file size first, then what VLC already showed */
+private fun withFileSize(context: Context, item: MediaLibraryItem?, description: String?): String? {
+    val mw = item as? MediaWrapper ?: return description
+    val size = BrowserFileSizes.sizeOf(mw) ?: return description
+    val sizeText = android.text.format.Formatter.formatFileSize(context, size)
+    return listOf(sizeText, description).filter { !it.isNullOrBlank() }.distinct().joinToString(" · ")
+}
 
