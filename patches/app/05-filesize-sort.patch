+    /**
+     * Folders first (by name), then files by size. Sizes are read once per sort (local files only;
+     * network files have no known size and are placed as 0 bytes). Same size -> by file name.
+     */
+    private fun sortBySize(files: MutableList<MediaLibraryItem>) {
+        val sizes = java.util.IdentityHashMap<MediaLibraryItem, Long>(files.size)
+        for (item in files) {
+            val mw = item as? MediaWrapper
+            sizes[item] = if (mw == null || mw.type == MediaWrapper.TYPE_DIR || mw.uri?.scheme != "file") 0L
+            else mw.uri?.path?.let { File(it).length() } ?: 0L
+        }
+        val byName = getFilenameAscComp(files.determineMaxNbOfDigits())
+        val isDir = { item: MediaLibraryItem -> (item as? MediaWrapper)?.type == MediaWrapper.TYPE_DIR }
+        files.sortWith(Comparator { a, b ->
+            val da = isDir(a)
+            val db = isDir(b)
+            when {
+                da && !db -> -1
+                !da && db -> 1
+                da && db -> byName.compare(a, b)
+                else -> {
+                    val c = (sizes[a] ?: 0L).compareTo(sizes[b] ?: 0L)
+                    if (c != 0) (if (desc) -c else c) else byName.compare(a, b)
+                }
+            }
+        })
+    }
